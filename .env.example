# Copy to .env and fill in. Free Alpaca paper keys: https://app.alpaca.markets
# (Paper Trading -> API Keys). Never commit .env. ALPACA_API_KEY / APCA_API_KEY_ID
# and APCA_API_SECRET_KEY also work. Check everything with `npm run doctor`.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# MCP server at /mcp. Leave both empty to turn it off. Make each one long and
# random, e.g. `openssl rand -hex 32`, and give it only to the bots that need it.
# Desk token: read tools (bars, indicators, Desk Signal, screen, news, positions).
OPENCHARTS_MCP_TOKEN=
# Risk Officer token: the read tools plus set_approval and revoke_approval.
OPENCHARTS_RISK_TOKEN=

# Webhooks for new Desk Signals on approved tickers. Comma-separated URLs.
# Every POST is signed with the secret (see docs/self-hosting.md).
OPENCHARTS_WEBHOOK_URLS=
OPENCHARTS_WEBHOOK_SECRET=

# Trader token for our own order tools (place_order, cancel_order). Only used
# when `orders.enabled` is on in opencharts.config.ts; off by default.
OPENCHARTS_TRADER_TOKEN=
